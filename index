<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spoorti Metri | Portfolio</title>
<style>
:root{
  --bg:#fbf6f0;--paper:#fffdf9;--ink:#3b3330;--muted:#7a6c66;
  --rose:#e8b4b8;--peach:#f6d5bd;--sage:#cfe0cc;--butter:#f7ecc3;
  --accent:#b5656d;--line:#ecdfd5;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:"Times New Roman",Times,serif;
  background:var(--bg);
  background-image:radial-gradient(circle at 10% 0%,var(--peach) 0,transparent 35%),radial-gradient(circle at 100% 30%,var(--sage) 0,transparent 30%);
  background-attachment:fixed;
  color:var(--ink);line-height:1.65;font-size:18px;
}
nav{
  position:sticky;top:0;z-index:10;
  display:flex;justify-content:center;flex-wrap:wrap;gap:6px 22px;
  padding:12px 16px;background:rgba(255,253,249,.92);
  backdrop-filter:blur(6px);border-bottom:1px solid var(--line);
}
nav a{
  color:var(--ink);text-decoration:none;font-size:17px;padding:2px 4px;
  border-bottom:2px solid transparent;
  transition:transform .25s,border-color .25s,color .25s;
}
nav a:hover{transform:translateY(-2px);border-color:var(--accent);color:var(--accent)}
.resume{
  max-width:900px;margin:32px auto;background:var(--paper);
  border:1px solid var(--line);border-radius:6px;
  box-shadow:0 18px 40px rgba(181,101,109,.12);overflow:hidden;
}
header{
  padding:48px 40px 32px;
  background:linear-gradient(120deg,var(--peach),var(--rose) 60%,var(--butter));
  text-align:center;animation:rise .9s ease both;
}
header h1{font-size:clamp(34px,7vw,52px);letter-spacing:2px;font-weight:700}
header .role{font-size:21px;font-style:italic;margin-top:4px}
.contact{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 14px;margin-top:22px}
.contact a,.contact span{
  color:var(--ink);text-decoration:none;font-size:16px;
  background:rgba(255,253,249,.75);padding:6px 14px;border-radius:30px;
  transition:transform .25s,background .25s;
}
.contact a:hover{transform:translateY(-3px) scale(1.04);background:#fff}
section{padding:30px 40px;border-top:1px solid var(--line)}
h2{font-size:24px;margin-bottom:16px;padding-bottom:6px;border-bottom:2px solid var(--rose);display:inline-block}
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s}
.reveal.show{opacity:1;transform:none}
.item{
  padding:14px 18px;margin-bottom:14px;border-left:4px solid var(--rose);
  background:#fff8f1;border-radius:0 8px 8px 0;
  transition:transform .3s,box-shadow .3s,border-color .3s;
}
.item:hover{transform:translateX(6px);box-shadow:0 8px 18px rgba(181,101,109,.15);border-color:var(--accent)}
.item h3{font-size:19px}
.item p{color:var(--muted);font-size:17px}
.score{font-weight:700;color:var(--accent)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.card{padding:18px;border-radius:10px;background:var(--sage);transition:transform .3s,box-shadow .3s}
.card:nth-child(2){background:var(--butter)}
.card:hover{transform:translateY(-6px) rotate(-.6deg);box-shadow:0 12px 22px rgba(0,0,0,.08)}
.card h3{font-size:19px;margin-bottom:6px}
.card p{font-size:17px}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chips span{
  padding:6px 16px;border-radius:30px;background:var(--butter);
  border:1px solid var(--line);font-size:17px;
  transition:transform .25s,background .25s;
}
.chips span:hover{transform:scale(1.08);background:var(--peach)}
.skill-row{margin-bottom:14px}
.skill-row strong{display:block;margin-bottom:6px}
ul.plain{list-style:none}
ul.plain li{padding:6px 0 6px 22px;position:relative}
ul.plain li::before{content:"";position:absolute;left:0;top:16px;width:9px;height:9px;border-radius:50%;background:var(--rose)}
.hobbies{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.hobbies div{
  padding:14px;text-align:center;border-radius:10px;background:var(--rose);
  overflow:visible;white-space:normal;transition:transform .3s;
}
.hobbies div:nth-child(2){background:var(--sage)}
.hobbies div:nth-child(3){background:var(--butter)}
.hobbies div:hover{transform:translateY(-5px) scale(1.04)}
.declaration p{font-style:italic}
.declaration .sign{margin-top:22px;text-align:right;font-weight:700;font-style:normal}
footer{text-align:center;padding:18px;color:var(--muted);font-size:15px;background:#fff8f1}
@keyframes rise{from{opacity:0;transform:translateY(-18px)}to{opacity:1;transform:none}}
@media (max-width:600px){
  body{font-size:17px}
  header{padding:36px 20px 26px}
  section{padding:24px 20px}
  .resume{margin:12px 8px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
  .reveal{opacity:1;transform:none}
}
</style>
</head>
